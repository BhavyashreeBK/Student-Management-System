<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Student Management System</title>

<!-- Bootstrap -->

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Bootstrap Icons -->

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<!-- Custom CSS -->

<link rel="stylesheet" href="/style.css">

</head>

<body>

<!-- Navbar -->

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

<div class="container">

<a class="navbar-brand fw-bold fs-4" href="/">

<i class="bi bi-mortarboard-fill"></i>

Student Management System

</a>

<button
class="navbar-toggler"
type="button"
data-bs-toggle="collapse"
data-bs-target="#navbarNav">

<span class="navbar-toggler-icon"></span>

</button>

<div
class="collapse navbar-collapse"
id="navbarNav">

<ul class="navbar-nav ms-auto">

<li class="nav-item">

<a class="nav-link active" href="/">

<i class="bi bi-house-fill"></i>

Home

</a>

</li>

<li class="nav-item">

<a class="nav-link" href="/students">

<i class="bi bi-people-fill"></i>

Students

</a>

</li>

<li class="nav-item">

<a class="nav-link" href="/about">

<i class="bi bi-info-circle-fill"></i>

About

</a>

</li>

</ul>

</div>

</div>

</nav>

<!-- Hero Section -->

<section class="bg-light py-5">

<div class="container">

<div class="row align-items-center">

<div class="col-lg-6">

<h1 class="display-4 fw-bold text-primary">

Student Management System

</h1>

<p class="lead mt-3">

A Full Stack Web Application developed using

<strong>Node.js</strong>,

<strong>Express.js</strong>,

<strong>MongoDB</strong>,

<strong>Bootstrap</strong>

and

<strong>EJS</strong>.

</p>

<div class="mt-4">

<a
href="#studentForm"
class="btn btn-primary btn-lg me-2">

<i class="bi bi-person-plus-fill"></i>

Register Student

</a>

<a
href="/students"
class="btn btn-outline-primary btn-lg">

<i class="bi bi-table"></i>

View Students

</a>

</div>

<h4
id="welcomeMessage"
class="mt-4 text-success">

👋 Welcome!

</h4>

</div>

<div class="col-lg-6 text-center">

<img

src="https://cdn-icons-png.flaticon.com/512/3135/3135755.png"

class="img-fluid"

style="max-height:320px;">

</div>

</div>

</div>

</section>

<!-- Feature Cards -->

<div class="container my-5">

<div class="row g-4">

<div class="col-md-4">

<div class="card shadow border-0 h-100">

<div class="card-body text-center">

<i class="bi bi-person-plus-fill display-4 text-primary"></i>

<h4 class="mt-3">

Student Registration

</h4>

<p>

Register students quickly and securely.

</p>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card shadow border-0 h-100">

<div class="card-body text-center">

<i class="bi bi-search display-4 text-success"></i>

<h4 class="mt-3">

Search Records

</h4>

<p>

Search student information instantly.

</p>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card shadow border-0 h-100">

<div class="card-body text-center">

<i class="bi bi-pencil-square display-4 text-warning"></i>

<h4 class="mt-3">

Manage Students

</h4>

<p>

Update and delete records easily.

</p>

</div>

</div>

</div>

</div>

</div>

<!-- Registration Form -->

<div class="container my-5">

<div class="card shadow-lg border-0 rounded-4">

<div class="card-body p-5">

<h2 class="text-center mb-4 text-primary">

<i class="bi bi-person-vcard-fill"></i>

Student Registration Form

</h2>

<form action="/submit" method="POST" id="studentForm">
    <!-- ================= Personal Details ================= -->

<h4 class="mb-4 text-primary">
<i class="bi bi-person-circle"></i>
Personal Details
</h4>

<div class="row">

<div class="col-md-6 mb-3">

<label class="form-label fw-bold">

<i class="bi bi-person-fill"></i>
Student Name

</label>

<input
type="text"
class="form-control form-control-lg"
name="name"
placeholder="Enter Student Name"
required>

</div>

<div class="col-md-6 mb-3">

<label class="form-label fw-bold">

<i class="bi bi-envelope-fill"></i>
Email Address

</label>

<input
type="email"
class="form-control form-control-lg"
name="email"
placeholder="Enter Email Address"
required>

</div>

<div class="col-md-6 mb-3">

<label class="form-label fw-bold">

<i class="bi bi-telephone-fill"></i>
Phone Number

</label>

<input
type="tel"
class="form-control form-control-lg"
name="phone"
placeholder="Enter Phone Number"
required>

</div>

<div class="col-md-6 mb-3">

<label class="form-label fw-bold">

<i class="bi bi-calendar-event-fill"></i>
Age

</label>

<input
type="number"
class="form-control form-control-lg"
name="age"
placeholder="Enter Age"
required>

</div>

</div>

<!-- Password -->

<div class="row">

<div class="col-md-6 mb-3">

<label class="form-label fw-bold">

<i class="bi bi-lock-fill"></i>
Password

</label>

<input
type="password"
class="form-control form-control-lg"
id="password"
name="password"
placeholder="Enter Password"
required>

<small
id="strengthMessage"
class="text-muted"></small>

</div>

<div class="col-md-6 mb-3">

<label class="form-label fw-bold">

<i class="bi bi-shield-lock-fill"></i>
Confirm Password

</label>

<input
type="password"
class="form-control form-control-lg"
id="confirmPassword"
placeholder="Confirm Password"
required>

<small
id="matchMessage"
class="text-muted"></small>

</div>

</div>

<!-- Gender -->

<div class="mb-4">

<label class="form-label fw-bold">

<i class="bi bi-gender-ambiguous"></i>
Gender

</label>

<div class="mt-2">

<div class="form-check form-check-inline">

<input
class="form-check-input"
type="radio"
name="gender"
value="Male">

<label class="form-check-label">

Male

</label>

</div>

<div class="form-check form-check-inline">

<input
class="form-check-input"
type="radio"
name="gender"
value="Female">

<label class="form-check-label">

Female

</label>

</div>

<div class="form-check form-check-inline">

<input
class="form-check-input"
type="radio"
name="gender"
value="Other">

<label class="form-check-label">

Other

</label>

</div>

</div>

</div>

<!-- Address -->

<label class="form-label fw-bold">

<i class="bi bi-geo-alt-fill"></i>
Address

</label>

<textarea
class="form-control"
id="address"
rows="4"
name="address"
placeholder="Enter Full Address"
maxlength="100"></textarea>

<div class="text-end">

<small
id="charCount"
class="text-muted">

0 / 100 Characters

</small>

</div>

<hr>

<!-- ================= Academic Details ================= -->

<h4 class="mb-4 text-primary">

<i class="bi bi-mortarboard-fill"></i>

Academic Details

</h4>
<!-- Academic Details -->

<div class="row">

<div class="col-md-4 mb-3">

<label class="form-label fw-bold">
<i class="bi bi-award-fill"></i>
Qualification
</label>

<select class="form-select form-select-lg" name="qualification">

<option value="">Select Qualification</option>

<option>SSLC</option>

<option>PUC</option>

<option>Diploma</option>

<option>Degree</option>

</select>

</div>

<div class="col-md-4 mb-3">

<label class="form-label fw-bold">
<i class="bi bi-book-fill"></i>
Course
</label>

<select class="form-select form-select-lg" name="course">

<option value="">Select Course</option>

<option>BE - Computer Science</option>

<option>BE - Information Science</option>

<option>BCA</option>

<option>BSc</option>

</select>

</div>

<div class="col-md-4 mb-3">

<label class="form-label fw-bold">
<i class="bi bi-journal-code"></i>
Interested Subject
</label>

<select class="form-select form-select-lg" name="subject">

<option value="">Select Subject</option>

<option>Web Development</option>

<option>Java</option>

<option>Python</option>

<option>Data Science</option>

</select>

</div>

</div>

<hr>

<!-- Skills -->

<h4 class="mb-4 text-primary">

<i class="bi bi-lightbulb-fill"></i>

Technical Skills

</h4>

<div class="row">

<div class="col-md-2 col-6 mb-3">

<div class="form-check">

<input
class="form-check-input"
type="checkbox"
name="skills"
value="HTML">

<label class="form-check-label">

HTML

</label>

</div>

</div>

<div class="col-md-2 col-6 mb-3">

<div class="form-check">

<input
class="form-check-input"
type="checkbox"
name="skills"
value="CSS">

<label class="form-check-label">

CSS

</label>

</div>

</div>

<div class="col-md-2 col-6 mb-3">

<div class="form-check">

<input
class="form-check-input"
type="checkbox"
name="skills"
value="JavaScript">

<label class="form-check-label">

JavaScript

</label>

</div>

</div>

<div class="col-md-2 col-6 mb-3">

<div class="form-check">

<input
class="form-check-input"
type="checkbox"
name="skills"
value="React">

<label class="form-check-label">

React

</label>

</div>

</div>

<div class="col-md-2 col-6 mb-3">

<div class="form-check">

<input
class="form-check-input"
type="checkbox"
name="skills"
value="Node.js">

<label class="form-check-label">

Node.js

</label>

</div>

</div>

<div class="col-md-2 col-6 mb-3">

<div class="form-check">

<input
class="form-check-input"
type="checkbox"
name="skills"
value="MongoDB">

<label class="form-check-label">

MongoDB

</label>

</div>

</div>

</div>

<hr>

<div class="text-center mt-4">

<button
type="submit"
class="btn btn-success btn-lg px-5 me-3">

<i class="bi bi-person-check-fill"></i>

Register Student

</button>

<button
type="reset"
class="btn btn-outline-secondary btn-lg">

<i class="bi bi-arrow-clockwise"></i>

Reset

</button>

</div>

</form>

</div>

</div>

</div>

